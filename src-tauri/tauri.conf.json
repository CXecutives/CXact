{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CXact",
  "identifier": "de.cxecutives.job-alert-monitor",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "CXact",
        "width": 1360,
        "height": 900,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "preventOverflow": true,
        "visible": false,
        "theme": "Light",
        "backgroundColor": "#F8F6F4",
        "dragDropEnabled": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/THIRD-PARTY.txt": "THIRD-PARTY.txt",
      "../core/tests/fixtures/matching/heldout8/jobs.json": "demo/heldout8/jobs.json",
      "../core/tests/fixtures/matching/heldout8/*.txt": "demo/heldout8/",
      "../core/tests/fixtures/matching/heldout9/jobs.json": "demo/heldout9/jobs.json",
      "../core/tests/fixtures/matching/heldout9/*.txt": "demo/heldout9/"
    }
  }
}
