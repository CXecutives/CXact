# Build output (tauri-build regenerates the permission files on every build)
target/
/src-tauri/gen/
/src-tauri/permissions/autogenerated/
node_modules/
/ui/dist/
/test-results/
/playwright-report/
/tools/ui-harness/.last-run.json

# Private test data (the user's real mails, pages and labels)
/core/tests/fixtures/private/

# Personal data - never commit, even if a work folder ends up in here
auswertung/
profil/
Profil_*.json
*.xlsx
# CVs: only the invented ones of the tests (tools/cv-fixtures.py)
*.doc
*.docx
*.docm
*.dotx
*.odt
*.rtf
*.pdf
*.pages
*.heic
!/core/tests/fixtures/cv/*

# The CV worker's local state and secrets (cv-worker/)
/cv-worker/.wrangler/
.dev.vars*
.env
.env.*

# System
Thumbs.db
desktop.ini
.DS_Store

# Local Claude Code files
/.claude/*
# The two preview servers (`ui-preview`, `ui-dev`) for Claude's browser pane.
!/.claude/launch.json

# Python caches of the helper scripts
__pycache__/
/.harness/
# The preview copy of the UI (tools/ui-preview.cmd)
/.preview/

# Throwaway scripts of UI sweeps and drafts (never committed).
/tools/ui-harness/zz-*.mjs
